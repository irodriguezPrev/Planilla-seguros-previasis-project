PORT=3004
CORS_ORIGIN=http://localhost:3000

# Clientify
CLIENTIFY_URL=https://api-plus.clientify.com/v2/
CLIENTIFY_URL_LOGIN=https://api.clientify.net/v1/api-auth/obtain_token/
CLIENTIFY_TIMEOUT_MS=10000
API_KEY=

# PostgreSQL para afiliaciones y firma remota
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/previasis_intermediarios
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Debe coincidir con la clave de firma de los JWT de autenticacion
PRIVATE_KEY=REEMPLAZAR_CON_LA_CLAVE_JWT_REAL
JWT_SECRET=
SIGNING_LINK_TTL_HOURS=72

# En desarrollo puede quedar vacío. En producción use el dominio HTTPS público
# del frontend, por ejemplo: https://afiliacion.ejemplo.com
PUBLIC_APP_URL=

# Cuenta de vendedor demostrativa (solo desarrollo, toggle apagado por defecto)
DEMO_SELLER_ENABLED=false
DEMO_SELLER_USERNAME=demo
DEMO_SELLER_PASSWORD=12345
